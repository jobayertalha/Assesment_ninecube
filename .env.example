# Required for answer generation. Get a key from your chosen Groq account.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Embedding model downloads once on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity threshold; validate against the evaluation set before changing.
MIN_RELEVANCE_SCORE=0.38
TOP_K=4
